{
    "name": "smart-attendance-backend",
    "version": "1.0.0",
    "description": "Backend for Corporate Smart Attendance System",
    "type": "module",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest",
        "reload": "pm2 delete lushaiAttendanceBackend || true && pm2 start ./bin/www --name lushaiAttendanceBackend",
        "prod": "pm2 start ./bin/www --name lushaiAttendanceBackend",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:apply-qr-migration": "node scripts/applyQRMigration.js"
    },
    "dependencies": {
        "@turf/turf": "^6.5.0",
        "bcryptjs": "^3.0.2",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "drizzle-orm": "^0.36.4",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "express-rate-limit": "^8.1.0",
        "express-validator": "^7.3.0",
        "haversine-distance": "^1.2.4",
        "helmet": "^8.1.0",
        "ipaddr.js": "^2.1.0",
        "jsonwebtoken": "^9.0.2",
        "moment": "^2.30.1",
        "multer": "^2.0.2",
        "nodemailer": "^7.0.10",
        "pg": "^8.13.1",
        "postgres": "^3.4.5",
        "qrcode": "^1.5.4",
        "winston": "^3.18.3",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "drizzle-kit": "^0.29.0",
        "jest": "^30.2.0",
        "nodemon": "^3.1.10"
    },
    "keywords": [
        "attendance",
        "corporate",
        "postgresql",
        "drizzle",
        "express"
    ],
    "author": "Lushai Technologies & Consultancy Pvt. Ltd."
}
